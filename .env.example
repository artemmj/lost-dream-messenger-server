DJANGO_SECRET_KEY=qwe
DJANGO_DEBUG=True

DB_NAME=db_messenger
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# --- Push (Firebase Cloud Messaging) -----------------------------------------
# 1 — слать push-уведомления о новых сообщениях тем, у кого нет активного
# WebSocket-канала. 0 (по умолчанию) — локальный запуск без Firebase-ключа:
# бэкенд поднимается, push просто не отправляется.
PUSH_ENABLED=0

# Project ID из Firebase Console (Project settings → General). Если не задан,
# берётся из поля project_id самого ключа service account.
FIREBASE_PROJECT_ID=

# Креденшел Admin SDK — service account key (Project settings → Service accounts
# → Generate new private key). Два варианта, JSON из env приоритетнее:
#   FIREBASE_CREDENTIALS_JSON — сам JSON одной строкой или base64 от него;
#   FIREBASE_CREDENTIALS_PATH — путь к файлу внутри контейнера (в compose
#     проброшен /app/secrets/firebase-service-account.json).
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# Имена Android-каналов — должны совпадать с каналами, которые создаёт клиент
# (flutter_local_notifications), иначе уведомление, показанное SDK при убитом
# приложении, попадёт в канал-заглушку без нужного звука и приоритета.
PUSH_CHANNEL_HIGH=mdm_messages_high
PUSH_CHANNEL_LOW=mdm_messages_low
PUSH_ICON=ic_notification
PUSH_COLOR=#4F46E5
# Через сколько секунд неотправленное уведомление считается просроченным:
# непрочитанное и так дотянется REST'ом при следующем открытии.
PUSH_TTL_SECONDS=14400
